{
  "description": "WealthWise guardrail hooks packaged by plugin.json (project settings register the same scripts directly).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/.claude/hooks/migration-append-only-check.js", "timeout": 5000 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/.claude/hooks/allocation-sum-invariant-check.js", "timeout": 5000 },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/.claude/hooks/no-float-money-check.js", "timeout": 5000 },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pii-log-check.js", "timeout": 5000 }
        ]
      }
    ]
  }
}
